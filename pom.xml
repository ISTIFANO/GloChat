<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.9</version>
        <relativePath/>
    </parent>

    <groupId>com.marketchat</groupId>
    <artifactId>marketchat-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>MarketChat</name>
    <description>AI-first conversational marketplace</description>

    <modules>
        <module>marketchat-common</module>
        <module>services/api-gateway</module>
        <module>services/commerce-service</module>
        <module>services/payment-service</module>
        <module>services/agent-service</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-ai.version>2.0.2</spring-ai.version>
        <spring-cloud.version>2025.1.4</spring-cloud.version>
        <stripe-java.version>34.1.0</stripe-java.version>
        <archunit.version>1.5.1</archunit.version>
        <!-- OpenTelemetry instrumentation release aligned with the OTel SDK 1.55 managed by Spring Boot 4.0.9 -->
        <otel-instrumentation.version>2.21.0-alpha</otel-instrumentation.version>
        <protobuf.version>4.32.0</protobuf.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.marketchat</groupId>
                <artifactId>marketchat-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry.instrumentation</groupId>
                <artifactId>opentelemetry-logback-appender-1.0</artifactId>
                <version>${otel-instrumentation.version}</version>
            </dependency>
            <!--
              google-genai (Spring AI Gemini) brings protobuf 3.25, OpenTelemetry's OTLP proto needs 4.x
              (com.google.protobuf.RuntimeVersion). Maven would pick 3.25 -> NoClassDefFoundError at startup.
              protobuf 4.x runs code generated with 3.x, so we align everything on the OTel requirement.
            -->
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <environmentVariables>
                            <!-- unit/integration tests must not need a running Grafana/OTel collector -->
                            <OTEL_EXPORT_ENABLED>false</OTEL_EXPORT_ENABLED>
                            <!-- no LLM in unit tests; the live Gemini test re-enables it explicitly -->
                            <SPRING_AI_MODEL_CHAT>none</SPRING_AI_MODEL_CHAT>
                        </environmentVariables>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
