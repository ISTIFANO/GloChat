# Copy to infra/.env and fill every value (infra/.env is git-ignored).
# Quick way: bash infra/generate-dev-env.sh  (random dev passwords)

POSTGRES_PASSWORD=change-me
COMMERCE_DB_PASSWORD=change-me
PAYMENT_DB_PASSWORD=change-me
AGENT_DB_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me

REDIS_PASSWORD=change-me

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
COMMERCE_CLIENT_SECRET=change-me
PAYMENT_CLIENT_SECRET=change-me
AGENT_CLIENT_SECRET=change-me
DEMO_USER_PASSWORD=change-me

# Needed later (Inc 0 Gemini check, Inc 4 Stripe, Inc 7 Langfuse) — personal keys only
GEMINI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional: "Continuer avec Google" (see infra/keycloak/configure-google.sh)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
