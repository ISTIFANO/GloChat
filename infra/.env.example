# Copy to infra/.env and fill every value (infra/.env is git-ignored).
# Quick way: bash infra/generate-dev-env.sh  (random dev passwords)

POSTGRES_PASSWORD=change-me
COMMERCE_DB_PASSWORD=change-me
PAYMENT_DB_PASSWORD=change-me
AGENT_DB_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me

REDIS_PASSWORD=change-me

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
COMMERCE_CLIENT_SECRET=change-me
PAYMENT_CLIENT_SECRET=change-me
AGENT_CLIENT_SECRET=change-me
DEMO_USER_PASSWORD=change-me

# Needed later (Inc 0 Gemini check, Inc 4 Stripe, Inc 7 Langfuse) — personal keys only
GEMINI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional: "Continuer avec Google" (see infra/keycloak/configure-google.sh)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Service URLs — no defaults in the code: every environment sets its own.
# Values below are for local development (services run on the host, infra in Docker).
# ---------------------------------------------------------------------------
WEB_BASE_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200
KEYCLOAK_PUBLIC_URL=http://localhost:8180
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/marketchat
KEYCLOAK_JWK_SET_URI=http://localhost:8180/realms/marketchat/protocol/openid-connect/certs
KEYCLOAK_TOKEN_URI=http://localhost:8180/realms/marketchat/protocol/openid-connect/token
COMMERCE_URL=http://localhost:8081
PAYMENT_URL=http://localhost:8084
AGENT_URL=http://localhost:8085
GATEWAY_URL=http://localhost:8080
COMMERCE_DB_URL=jdbc:postgresql://localhost:5432/commerce_db
PAYMENT_DB_URL=jdbc:postgresql://localhost:5432/payment_db
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
GRAFANA_URL=http://localhost:3001
